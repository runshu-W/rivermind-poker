{
  "schema_version": "coach-eval-corpus/1.0.0",
  "expected_cases": 50,
  "purpose": "Deterministic contract and adversarial checks; not expert-rated coaching quality goldens.",
  "cases": [
    {
      "id": "valid_base",
      "category": "valid",
      "description": "The minimal evidence-bound candidate is accepted.",
      "expected_status": "accepted",
      "expected_issue_codes": []
    },
    {
      "id": "valid_headline_prefix",
      "category": "valid",
      "description": "Non-numeric editorial text may surround a fact placeholder.",
      "expected_status": "accepted",
      "expected_issue_codes": [],
      "set": {"headline": "重点复盘：{{signal.title}}"}
    },
    {
      "id": "valid_observation_style",
      "category": "valid",
      "description": "Observation phrasing may change while all claims remain referenced.",
      "expected_status": "accepted",
      "expected_issue_codes": [],
      "set": {"observation": "观察到{{signal.observed_percentage}}；样本为{{signal.sample}}；区间为{{signal.confidence_interval_95}}；规则触发线为{{rule.trigger}}。"}
    },
    {
      "id": "valid_teaching_style",
      "category": "valid",
      "description": "Teaching text can join rationale and limitation facts.",
      "expected_status": "accepted",
      "expected_issue_codes": [],
      "set": {"teaching_point": "复盘原因：{{rule.rationale}}适用边界：{{limitations.context}}"}
    },
    {
      "id": "valid_review_single_step",
      "category": "valid",
      "description": "One review step can reference both the prompt and anonymous hand.",
      "expected_status": "accepted",
      "expected_issue_codes": [],
      "set": {"review_plan": ["{{rule.review_prompt}}；再看{{hand.1}}。"]}
    },
    {
      "id": "valid_review_four_steps",
      "category": "valid",
      "description": "The maximum supported review-plan length is accepted.",
      "expected_status": "accepted",
      "expected_issue_codes": [],
      "set": {"review_plan": ["{{rule.review_prompt}}", "先看{{hand.1}}。", "按位置归类。", "记录重复环境。"]}
    },
    {
      "id": "valid_uncertainty_style",
      "category": "valid",
      "description": "Uncertainty can be framed without inventing a claim.",
      "expected_status": "accepted",
      "expected_issue_codes": [],
      "set": {"uncertainty": "证据边界：{{limitations.no_gto}}"}
    },
    {
      "id": "valid_reordered_refs",
      "category": "valid",
      "description": "Evidence reference order is not semantically significant.",
      "expected_status": "accepted",
      "expected_issue_codes": [],
      "set": {"evidence_refs": ["hand.1", "limitations.no_gto", "rule.review_prompt", "limitations.context", "rule.rationale", "rule.trigger", "signal.confidence_interval_95", "signal.sample", "signal.observed_percentage", "signal.title"]}
    },
    {
      "id": "schema_missing_headline",
      "category": "schema",
      "description": "A required scalar field cannot be omitted.",
      "expected_status": "rejected",
      "expected_issue_codes": ["missing_field", "invalid_type"],
      "remove": ["headline"]
    },
    {
      "id": "schema_missing_review_plan",
      "category": "schema",
      "description": "A required array field cannot be omitted.",
      "expected_status": "rejected",
      "expected_issue_codes": ["missing_field", "invalid_type"],
      "remove": ["review_plan"]
    },
    {
      "id": "schema_missing_evidence_refs",
      "category": "schema",
      "description": "Evidence references are required.",
      "expected_status": "rejected",
      "expected_issue_codes": ["missing_field", "invalid_type"],
      "remove": ["evidence_refs"]
    },
    {
      "id": "schema_unknown_field",
      "category": "schema",
      "description": "Provider-specific or action fields cannot be added.",
      "expected_status": "rejected",
      "expected_issue_codes": ["unknown_field"],
      "set": {"action": "raise"}
